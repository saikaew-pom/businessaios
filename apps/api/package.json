{
  "name": "@businessaios/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "d1:create": "wrangler d1 create businessaios-db",
    "d1:migrate:local": "wrangler d1 migrations apply businessaios-db --local",
    "d1:migrate:remote": "wrangler d1 migrations apply businessaios-db --remote",
    "tail": "wrangler tail",
    "typecheck": "tsc --noEmit",
    "typecheck:test": "tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@cf-wasm/photon": "^0.4.0",
    "@resvg/resvg-wasm": "^2.6.2",
    "bcryptjs": "^3.0.3",
    "hono": "^4.6.10",
    "pptxgenjs": "^4.0.1",
    "resend": "^4.0.0",
    "satori": "^0.29.0",
    "stripe": "^17.5.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241218.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.10",
    "wrangler": "^4.0.0"
  }
}
